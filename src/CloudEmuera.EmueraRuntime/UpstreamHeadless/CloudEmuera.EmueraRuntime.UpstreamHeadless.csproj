<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CloudEmuera.EmueraRuntime.UpstreamHeadless</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DefineConstants>CLOUDEMUERA_HEADLESS</DefineConstants>
    <AssemblyVersion>18.2.4.0</AssemblyVersion>
    <FileVersion>18.2.4.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../CloudEmuera.RuntimeAdapter/CloudEmuera.RuntimeAdapter.csproj" />
    <PackageReference Include="Enums.NET" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Upstream/Emuera/GlobalStatic.cs" />
    <Compile Include="../Upstream/Emuera/UI/Dialog.cs" />
    <Compile Include="../Upstream/Emuera/UI/FontFactory.cs" />
    <Compile Include="../Upstream/Emuera/UI/Game/**/*.cs"
             Exclude="../Upstream/Emuera/UI/Game/EmueraConsole.cs;../Upstream/Emuera/UI/Game/EmueraConsole.Print.cs;../Upstream/Emuera/UI/Game/HotkeyState.cs;../Upstream/Emuera/UI/Game/Rikaichan.cs;../Upstream/Emuera/UI/Game/RikaichanAutogenerated.cs" />
    <Compile Include="../Upstream/Emuera/Runtime/**/*.cs"
             Exclude="../Upstream/Emuera/Runtime/Script/Statements/Clipboard.cs;../Upstream/Emuera/Runtime/Utils/PluginSystem/PluginManager.cs;../Upstream/Emuera/Runtime/Utils/Sound.NAudio.cs;../Upstream/Emuera/Runtime/Utils/Sound.WMP.cs;../Upstream/Emuera/Runtime/Utils/NAudio_LoopStream.cs;../Upstream/Emuera/Runtime/Utils/WebPWrapper.cs" />
    <Compile Include="HeadlessPlatformStubs.cs" />
    <Compile Include="HeadlessWebpDecoder.cs" />
    <Compile Include="HeadlessFontMetrics.cs" />
    <Compile Include="HeadlessPngEncoder.cs" />
    <Compile Include="HeadlessDisplayText.cs" />
    <Compile Include="HeadlessFileSystem.cs" />
    <Compile Include="HeadlessStringConverter.cs" />
    <Compile Include="HeadlessEmueraConsole.cs" />
    <Compile Include="UpstreamHtmlTranslator.cs" />
    <Compile Include="UpstreamRuntimeSession.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="MinorShift.Emuera.Runtime.Utils.HeadlessFile" Alias="File" />
    <Using Include="MinorShift.Emuera.Runtime.Utils.HeadlessDirectory" Alias="Directory" />
    <Using Include="MinorShift.Emuera.Runtime.Utils.HeadlessFileStream" Alias="FileStream" />
    <Using Include="MinorShift.Emuera.Runtime.Utils.HeadlessStreamReader" Alias="StreamReader" />
    <Using Include="MinorShift.Emuera.Runtime.Utils.HeadlessStreamWriter" Alias="StreamWriter" />
  </ItemGroup>
</Project>
