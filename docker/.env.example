# Copy this file to docker/.env, then run from this directory:
#   docker compose up -d

# Named volumes run as root by default. For a bind mount, uncomment these and
# replace them with the account that owns the host directory (id -u / id -g).
# CLOUDEMUERA_UID=1000
# CLOUDEMUERA_GID=1000

# Leave unset to use the managed Docker volume "cloudemuera-data".
# Uncomment and set a host path to use a bind mount instead. Relative paths
# are resolved from this docker/ directory; an absolute path is recommended.
# CLOUDEMUERA_DATA_PATH=/absolute/path/to/cloudemuera-data

# Host and container HTTP ports. The default binds only to loopback; expose
# this through an external HTTPS reverse proxy. Set the bind address explicitly
# only when direct host exposure is intentional.
CLOUDEMUERA_HTTP_BIND_ADDRESS=127.0.0.1
CLOUDEMUERA_HTTP_PORT=28647
CLOUDEMUERA_CONTAINER_PORT=28647

# Optional image override. The default builds cloudemuera:local from this repository.
# CLOUDEMUERA_PRODUCTION_IMAGE=cloudemuera:local

# First-run administrator bootstrap. Login uses the email address; the first
# login must change this temporary password.
CLOUDEMUERA_BOOTSTRAP_ADMIN_USERNAME=admin
CLOUDEMUERA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CLOUDEMUERA_BOOTSTRAP_ADMIN_PASSWORD=temporary-password

# Optional. Set true only when the public entrypoint is HTTPS. The application
# does not infer or redirect protocols; an upstream proxy owns that policy.
# CLOUDEMUERA_SECURITY_SECURE_COOKIES=true

# Optional whole-instance resource limits. CPU is intentionally not limited by
# the production Compose file.
# CLOUDEMUERA_MEMORY_LIMIT=2g
# CLOUDEMUERA_PIDS_LIMIT=512

# Development-only values. They are ignored by the production compose service.
# ASPNETCORE_ENVIRONMENT=Development
# Development host port; production uses CLOUDEMUERA_HTTP_PORT (28647).
CLOUDEMUERA_DEV_HTTP_PORT=28648
# CLOUDEMUERA_WEB_PORT=5173
