# Copy this file to docker/.env, replace the UID/GID with the account that
# owns the deployment, then run from this directory:
#   docker compose up -d

# The numeric identity used by API, Worker, Validator and Migrator.
# Replace these examples with: id -u / id -g
CLOUDEMUERA_UID=1000
CLOUDEMUERA_GID=1000

# Leave unset to use the managed Docker volume "cloudemuera-data".
# Uncomment and set a host path to use a bind mount instead. Relative paths
# are resolved from this docker/ directory; an absolute path is recommended.
# CLOUDEMUERA_DATA_PATH=/absolute/path/to/cloudemuera-data

# Host and container HTTP ports.
CLOUDEMUERA_HTTP_PORT=28647
CLOUDEMUERA_CONTAINER_PORT=28647

# Optional image override. The default builds cloudemuera:local from this repository.
# CLOUDEMUERA_PRODUCTION_IMAGE=cloudemuera:local

# First-run administrator bootstrap. Login uses the email address; the first
# login must change this temporary password.
CLOUDEMUERA_BOOTSTRAP_ADMIN_USERNAME=admin
CLOUDEMUERA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CLOUDEMUERA_BOOTSTRAP_ADMIN_PASSWORD=temporary-password

# Optional whole-instance resource limits.
# CLOUDEMUERA_CPU_LIMIT=2.00
# CLOUDEMUERA_MEMORY_LIMIT=2g
# CLOUDEMUERA_PIDS_LIMIT=512

# Optional instance-wide capacity overrides. Byte fields are integer bytes and count fields are positive integers.
# CLOUDEMUERA_CAPACITY_MAX_ACTIVE_WORKERS=8
# CLOUDEMUERA_CAPACITY_MAX_INACTIVE_SESSIONS=64
# CLOUDEMUERA_CAPACITY_MAX_ARCHIVE_BYTES=2147483648
# CLOUDEMUERA_CAPACITY_MAX_EXPANDED_BYTES=4294967296
# CLOUDEMUERA_CAPACITY_MAX_ARCHIVE_SINGLE_FILE_BYTES=1073741824
# CLOUDEMUERA_CAPACITY_MAX_ARCHIVE_ENTRY_COUNT=50000
# CLOUDEMUERA_CAPACITY_MAX_SESSION_ROOT_BYTES=4294967296
# CLOUDEMUERA_CAPACITY_MAX_SESSION_ROOT_FILE_COUNT=50000
# CLOUDEMUERA_CAPACITY_MAX_STAGING_RESERVED_BYTES=12884901888
# CLOUDEMUERA_CAPACITY_MAX_SAVE_FILE_BYTES=67108864
# CLOUDEMUERA_CAPACITY_MAX_SAVE_LISTED_FILES=4096
# CLOUDEMUERA_CAPACITY_MAX_SAVE_LIST_BYTES=8388608
# CLOUDEMUERA_CAPACITY_MIN_DATA_ROOT_FREE_BYTES=1073741824
# CLOUDEMUERA_CAPACITY_MAX_GAME_PACKAGE_BYTES=2147483648 # deprecated compatibility key

# Realtime/Worker/asset bounds. Omitted values use validated code defaults.
# CLOUDEMUERA_REALTIME_SNAPSHOT_MAX_BYTES=12582912
# CLOUDEMUERA_REALTIME_BATCH_TARGET_BYTES=262144
# CLOUDEMUERA_REALTIME_BATCH_MAX_TRANSACTIONS=64
# CLOUDEMUERA_REALTIME_BATCH_MAX_DELAY_MILLISECONDS=100
# CLOUDEMUERA_REALTIME_QUEUE_SOFT_BYTES=1048576
# CLOUDEMUERA_REALTIME_QUEUE_HARD_BYTES=2097152
# CLOUDEMUERA_REALTIME_QUEUE_SOFT_MESSAGES=32
# CLOUDEMUERA_REALTIME_QUEUE_HARD_MESSAGES=64
# CLOUDEMUERA_REALTIME_MAX_CONNECTIONS=256
# CLOUDEMUERA_REALTIME_MAX_CONNECTIONS_PER_SESSION=16
# CLOUDEMUERA_REALTIME_MAX_PENDING_INPUTS_PER_CONNECTION=32
# CLOUDEMUERA_REALTIME_MAX_PENDING_INPUTS_PER_WORKER=128
# CLOUDEMUERA_REALTIME_CONTROL_QUEUE_MAX_BYTES=262144
# CLOUDEMUERA_REALTIME_CONTROL_QUEUE_MAX_MESSAGES=64
# CLOUDEMUERA_REALTIME_ENVELOPE_MAX_BYTES=2048
# CLOUDEMUERA_WORKER_PENDING_EVENT_MAX_BYTES=1048576
# CLOUDEMUERA_WORKER_PENDING_EVENT_MAX_MESSAGES=256
# CLOUDEMUERA_ASSETS_MAX_MANIFEST_BYTES=4194304
# CLOUDEMUERA_ASSETS_MAX_ASSET_BYTES=536870912
# CLOUDEMUERA_ASSETS_MAX_RANGE_BYTES=67108864
# CLOUDEMUERA_ASSETS_MAX_CONCURRENT_READS=32
# CLOUDEMUERA_ASSETS_MAX_IN_FLIGHT_BYTES=536870912

# Development-only values. They are ignored by the production compose service.
# ASPNETCORE_ENVIRONMENT=Development
# CLOUDEMUERA_WEB_PORT=5173
