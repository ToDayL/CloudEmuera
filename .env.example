CLOUDEMUERA_HTTP_PORT=28647
CLOUDEMUERA_WEB_PORT=5173
CLOUDEMUERA_DATA_PATH=./data
ASPNETCORE_ENVIRONMENT=Development

# P1-02: used exactly once when a fresh database has not bootstrapped an administrator.
# Login uses the email address; the first login must change this temporary password.
CLOUDEMUERA_BOOTSTRAP_ADMIN_USERNAME=admin
CLOUDEMUERA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CLOUDEMUERA_BOOTSTRAP_ADMIN_PASSWORD=temporary-password

# Optional instance-wide capacity overrides (the first two values are counts; the remaining values are bytes).
# CLOUDEMUERA_CAPACITY_MAX_ACTIVE_WORKERS=8
# CLOUDEMUERA_CAPACITY_MAX_INACTIVE_SESSIONS=64
# CLOUDEMUERA_CAPACITY_MAX_GAME_PACKAGE_BYTES=2147483648
# CLOUDEMUERA_CAPACITY_MAX_SESSION_ROOT_BYTES=4294967296
# CLOUDEMUERA_CAPACITY_MAX_STAGING_RESERVED_BYTES=12884901888
# CLOUDEMUERA_CAPACITY_MIN_DATA_ROOT_FREE_BYTES=1073741824

# UID/GID are detected automatically by scripts/lib/dev-env.sh.
# Override only when the container must use a different host identity.
# CLOUDEMUERA_UID=1000
# CLOUDEMUERA_GID=1000
