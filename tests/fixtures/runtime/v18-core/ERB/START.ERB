@SYSTEM_TITLE
#DIM score
score = 2
PRINTL V18-START
CALL SHOW_READY
INPUT
IF RESULT == 8
    savedValue = 818
    globalValue = 1818
    SAVEDATA 0, "V18-SAVE"
    SAVEGLOBAL
    PRINTL V18-SAVE-COMPLETE
    QUIT
ELSEIF RESULT == 9
    savedValue = -1
    globalValue = -1
    LOADGLOBAL
    LOADDATA 0
ELSEIF RESULT == 7
    score = score + 1
    PRINTL V18-BRANCH-HIGH
ELSE
    score = score - 1
    PRINTL V18-BRANCH-LOW
ENDIF
PRINTFORML V18-SCORE={score}
HTML_PRINT "<b>V18-HTML</b>"
PRINT_IMG "V18_SPRITE"
PRINTL V18-IMAGE
PRINTL V18-SPRITE
PRINTL V18-SAVE-ROOT-SEMANTIC
PRINTL V18-END
QUIT

@SHOW_READY
PRINTL V18-READY
PRINTL V18-INPUT
RETURN

@EVENTLOAD
PRINTFORML V18-LOADED-SAVE={savedValue}
PRINTFORML V18-LOADED-GLOBAL={globalValue}
QUIT
