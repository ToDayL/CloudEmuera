@SYSTEM_TITLE
#DIM score
score = 2
PRINTL V18-START
CALL SHOW_READY
INPUT
IF RESULT == 7
    score = score + 1
    PRINTL V18-BRANCH-HIGH
ELSE
    score = score - 1
    PRINTL V18-BRANCH-LOW
ENDIF
PRINTFORML V18-SCORE={score}
HTML_PRINT "<b>V18-HTML</b>"
PRINT_IMG "V18_SPRITE"
PRINTL V18-IMAGE
PRINTL V18-SPRITE
PRINTL V18-SAVE-ROOT-SEMANTIC
PRINTL V18-END
QUIT

@SHOW_READY
PRINTL V18-READY
PRINTL V18-INPUT
RETURN
